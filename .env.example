# ─────────────────────────────────────────────────────────────────────────────
# CloudKitchen ONE — backend environment
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` (it is gitignored). Keep secrets out of git entirely.
# ─────────────────────────────────────────────────────────────────────────────

# HTTP port the API listens on (local dev + VPS).
PORT=5003

# Auth — a long, random string used to sign/verify JWT access tokens.
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Print Agent BOOTSTRAP token (sent as the X-Agent-Token header on POST
# /agent/register ONLY — SF-2). Narrow-scope, shared install-time secret for
# the .NET tray app; never a user account / user JWT. Every OTHER agent call
# (pending pull / ack / printer heartbeat) uses the PER-AGENT token that
# /agent/register returns (raw, once) in its response — NOT this value.
AGENT_TOKEN=replace-with-a-random-agent-token

# Database — Postgres connection string (Supabase pooled URL in prod, or any Postgres).
# The automated test suite uses embedded PGlite and does NOT need this.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# CORS (SF-3) — comma-separated allowlist of exact origins allowed to call the
# API / open a Socket.IO connection. Leave unset to use the built-in defaults:
# local Vite dev origins + the known production Vercel frontend + ANY
# https://*.vercel.app origin (Vercel preview deploys). Only set this if you
# need to add something the defaults don't cover (e.g. a custom domain).
# A bare "*" is intentionally NOT supported — see src/cors.ts.
#   CORS_ORIGINS=https://your-custom-domain.com,https://staging.example.com
# CORS_ORIGIN (singular, legacy) is still read as a one-item fallback if
# CORS_ORIGINS is unset, for backward compatibility with existing deploys.
CORS_ORIGINS=

# Login rate limit (SF-3) — throttles POST /auth/login per IP. Defaults: 10
# attempts per 15 minutes in dev/prod; a very high ceiling under
# NODE_ENV=test so the test suite's own repeated login calls never trip it.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Cloudinary — image / photo uploads (EMS attendance photo proof, brand logos).
# REQUIRED for POST /api/v1/ems/attendance; other endpoints work without it.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─────────────────────────────────────────────────────────────────────────────
# Deliverect (chosen order middleware, D9/D28) — paste when Deliverect rep
# issues staging creds. Until DELIVERECT_HMAC_SECRET is set, inbound
# DELIVERECT webhooks are rejected (fail closed); until DELIVERECT_API_TOKEN +
# DELIVERECT_API_BASE_URL are set, outbound commands return a TERMINAL
# "not configured" result instead of a fake success. See
# Documents/DELIVERECT_SETUP.md for the full onboarding runbook.
# ─────────────────────────────────────────────────────────────────────────────

# Inbound webhook HMAC secret. Staging = the channelLinkId Deliverect issues
# for the POS connection; production = a separate secret Deliverect provides.
DELIVERECT_HMAC_SECRET=
# Optional — set only during a secret rotation overlap window.
DELIVERECT_HMAC_SECRET_PREVIOUS=

# Optional override for Deliverect's `channel` -> ORION aggregator mapping,
# as a JSON object, e.g. {"panda":"FOODPANDA","grab":"GRABFOOD"}. Leave unset
# to use the built-in default map (src/modules/middleware/deliverect-secrets.ts).
DELIVERECT_CHANNEL_MAP=

# Outbound: Deliverect's API base URL + auth token (confirm exact auth form
# with the Deliverect rep before go-live — see
# src/modules/outbound/deliverect-adapter.ts's file header).
DELIVERECT_API_BASE_URL=
DELIVERECT_API_TOKEN=

# Foodpanda / Delivery Hero Integration Middleware API v2 outbound.
# Leave blank until official staging credentials are issued; with any value
# missing, outbound FOODPANDA commands fail closed without network calls.
FOODPANDA_MIDDLEWARE_BASE_URL=
FOODPANDA_MIDDLEWARE_USERNAME=
FOODPANDA_MIDDLEWARE_PASSWORD=
FOODPANDA_CHAIN_CODE=

# Foodpanda / Delivery Hero POS Plugin API inbound.
# Leave JWT secret blank until Delivery Hero issues plugin credentials; blank
# keeps the inbound plugin routes inert (503). Expose only behind valid,
# non-self-signed TLS at the infrastructure/proxy layer.
FOODPANDA_PLUGIN_BASE_PATH=/api/v1/foodpanda
FOODPANDA_PLUGIN_JWT_SECRET=
# Comma-separated hostname suffixes ORION is allowed to POST order callbacks to.
# Delivery Hero sends per-order callback URLs inside the inbound dispatch payload;
# posting to an unvalidated URL would be a Server-Side Request Forgery hole, so the
# allowlist is enforced (anchored suffix match, https only, no IP literals or ports).
# Leave unset to use the built-in default: restaurant-partners.com
FOODPANDA_CALLBACK_HOST_SUFFIXES=

# ─────────────────────────────────────────────────────────────────────────────
# GrabFood Partner API — INBOUND (Grab calls ORION)
# Note the inversion vs the Foodpanda plugin: ORION ISSUES the OAuth token here.
# Grab POSTs client_credentials to {GRAB_PARTNER_BASE_PATH}/oauth/token, ORION
# mints an HS256 JWT, and Grab bears that token on every other partner endpoint.
# Leave CLIENT_ID/CLIENT_SECRET/TOKEN_SECRET unset to keep the whole inbound
# module disabled — every route then fails closed with 503.
# ─────────────────────────────────────────────────────────────────────────────
GRAB_PARTNER_BASE_PATH=/api/v1/grab
# The credentials WE hand to Grab so Grab can obtain a token from us (<=32 chars each).
GRAB_PARTNER_CLIENT_ID=
GRAB_PARTNER_CLIENT_SECRET=
# Signing key for the access tokens ORION mints for Grab. MUST be distinct from
# GRAB_PARTNER_CLIENT_SECRET and from JWT_SECRET. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
GRAB_PARTNER_TOKEN_SECRET=
# Token lifetime. Grab's own sample uses 604799s (~7 days).
GRAB_PARTNER_TOKEN_TTL_SECONDS=604799
# Rate limit on the token endpoint (auth endpoints must be throttled).
GRAB_PARTNER_OAUTH_RATE_LIMIT_MAX=20
GRAB_PARTNER_OAUTH_RATE_LIMIT_WINDOW_MS=900000

# ─────────────────────────────────────────────────────────────────────────────
# GrabFood Partner API — OUTBOUND (ORION calls Grab)
# Credentials Grab issues to US after the partner application is approved.
# Unset => the outbound adapter fails closed (TERMINAL "not configured"), never
# a silent no-op and never a retry loop.
# ─────────────────────────────────────────────────────────────────────────────
GRAB_API_CLIENT_ID=
GRAB_API_CLIENT_SECRET=
# "staging" or "production". NO DEFAULT ON PURPOSE — silently guessing which
# environment to hit is worse than refusing to run. staging =>
# /grabfood-sandbox/partner/v1, production => /grabfood/partner/v1.
GRAB_API_ENV=
# Partner API host. Both staging and production share this one domain.
GRAB_API_BASE_URL=https://partner-api.grab.com
# OAuth token endpoint. NOTE: a DIFFERENT host from the partner API above —
# this is api.grab.com, not partner-api.grab.com. Same URL for both envs.
GRAB_API_TOKEN_URL=https://api.grab.com/grabid/v1/oauth2/token
